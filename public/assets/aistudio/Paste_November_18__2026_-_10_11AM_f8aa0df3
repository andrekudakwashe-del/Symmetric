/**
 * ============================================================================
 * HTTP POST HANDLER (doPost)
 * Core Atomic Router with Selective Locking, Idempotency, and License Checks
 * Quota Rule: 1 openById per request. Never loop sheets.
 * Performance: READ actions skip locks entirely. WRITE actions lock with 10s timeout.
 * ============================================================================
 */
function doPost(e) {
  var lock = null;
  var hasLock = false;

  try {
    if (!e || !e.postData || !e.postData.contents) {
      return json({ success: false, message: "Empty request payload" });
    }

    var req = JSON.parse(e.postData.contents);
    var action = req.action;
    var data = req.data || {};
    var company_id = req.company_id || data.company_id || "";
    var branch_id = req.branch_id || data.branch_id || getTenantPrimaryBranch(company_id);
    var user_id = req.user_id || req.staffId || data.user_id || data.staffId || "USR-001";
    var user_role = (req.user_role || req.role || data.user_role || data.role || "CASHIER").toUpperCase();
    var user_branch_id = req.user_branch_id || data.user_branch_id || branch_id;

    var master = getMasterSpreadsheet();

    // Check daily master tabs check (avoids per-request ensureAllMasterTabsExist overhead)
    checkDailyMasterTabs(master);

    // Whitelist of public / admin / setup actions that do not require pre-existing company context
    var isPublicOrAdminAction = [
      "signup",
      "login",
      "login_owner",
      "owner_login",
      "login_staff",
      "staff_login",
      "verify_staff_pin",
      "health",
      "setup_sheets",
      "init_master_sheet",
      "initialize_tenant_sheet",
      "init_tenant_sheet",
      "setup_tenant_tabs",
      "sync_inventory",
      "get_inventory",
      "get_products",
      "upsert_product",
      "get_companies",
      "get_users",
      "sync_company",
      "register_company",
      "sync_companies_bulk",
      "bulk_sync_companies",
      "lookup_company",
      "lookup_branch",
      "get_tenant_context",
      "get_users_since",
      "get_branches_since",
      "schema_health_check",
      "merge_duplicate_companies",
      "migrate_tenant"
    ].indexOf(action) !== -1;

    // WORK STREAM A & B: Lock ONLY Write actions & Enforce Idempotency
    var isWriteAction = action && WRITE_ACTIONS.indexOf(action.toLowerCase()) !== -1;
    var clientRequestId = req.clientRequestId || req.client_request_id || req.requestId || (data && (data.clientRequestId || data.client_request_id || data.requestId));

    if (isWriteAction) {
      // Require clientRequestId on all mutating write actions for strict idempotency
      if (!clientRequestId) {
        return json({
          success: false,
          error: "MISSING_REQUEST_ID",
          message: "Write action requires a unique clientRequestId for idempotency and replay protection."
        });
      }

      // Check request_log / cache first: if already processed, return cached response
      var cachedResponse = findCachedResponse(master, clientRequestId);
      if (cachedResponse) {
        cachedResponse.idempotent = true;
        cachedResponse.cached = true;
        return json(cachedResponse);
      }

      // Acquire lock for write actions (10000ms timeout)
      lock = LockService.getScriptLock();
      try {
        hasLock = lock.tryLock(10000);
      } catch (lockErr) {
        hasLock = false;
      }

      if (!hasLock) {
        return json({
          success: false,
          error: "RETRY_LATER",
          retryAfterMs: 2000,
          message: "Server busy. Could not acquire write lock. Please retry in 2000ms."
        });
      }
    }

    // 1. MULTI-TENANT CONTEXT ENFORCEMENT
    // Reject any non-auth request that lacks a valid company_id
    if (!isPublicOrAdminAction) {
      if (!company_id) {
        return json({
          success: false,
          status: 403,
          error: "MISSING_COMPANY_ID",
          message: "Access Denied: Missing company_id in request. Multi-tenant isolation requires a company context."
        });
      }
    }

    // 2. BRANCH DATA ISOLATION CONSTRAINT
    // Zero data leakage: Non-superadmin/non-owner cannot read or write to other branches
    if (!isPublicOrAdminAction) {
      if (user_role !== "SUPER_ADMIN" && user_role !== "OWNER" && user_branch_id !== branch_id) {
        return json({
          success: false,
          status: 403,
          error: "FORBIDDEN_BRANCH_ACCESS",
          message: "Forbidden: Cross-branch data leakage strictly blocked. User branch (" + user_branch_id + ") cannot access branch (" + branch_id + ")."
        });
      }
    }

    // 3. LICENSE & 14-DAY TRIAL STATUS CHECK (Unless signup or login)
    if (!isPublicOrAdminAction && action !== "confirm_payment" && action !== "extend_trial") {
      var comp = getCompany(company_id);
      if (comp) {
        if (comp.subscription_status === "CANCELLED" || comp.subscription_status === "SUSPENDED" || comp.subscription_status === "PAST_DUE") {
          return json({
            success: false,
            error: "LICENSE_INACTIVE",
            message: "Company subscription is " + comp.subscription_status + ". Please contact administrator to activate."
          });
        }

        // 14-day trial verification: must be confirmed paid by admin once 14 days lapse
        if (comp.subscription_status === "TRIAL") {
          var isExpired = false;
          if (comp.next_billing_date) {
            isExpired = new Date().getTime() > (new Date(comp.next_billing_date).getTime() + 86400000);
          } else if (comp.trial_start_date) {
            isExpired = daysSince(comp.trial_start_date) > 14;
          }

          if (isExpired) {
            return json({
              success: false,
              error: "TRIAL_EXPIRED",
              message: "Your 14-day free trial has expired. Payment confirmation required by administrator before you can continue using the system."
            });
          }
        }
      }
    }

    // 4. ATOMIC SINGLE SPREADSHEET OPEN (Quota: 1 openById per request. Never loop sheets.)
    var explicitSheetId = req.tenant_sheet_id || req.sheet_id || (req.data && (req.data.tenant_sheet_id || req.data.sheet_id));
    var branchSheetId = (explicitSheetId && String(explicitSheetId).trim().length > 10) ? String(explicitSheetId).trim() : getSheetId(company_id, branch_id);
    var targetSpreadsheet = null;
    var sheetOpenError = null;
    if (branchSheetId && branchSheetId.length > 10 && branchSheetId !== MASTER_ID) {
      try {
        targetSpreadsheet = SpreadsheetApp.openById(branchSheetId);
      } catch (err) {
        sheetOpenError = err.toString();
        Logger.log("Could not open tenant/branch sheet (" + branchSheetId + "): " + err.toString());
      }
    }
    if (!targetSpreadsheet) {
      targetSpreadsheet = getMasterSpreadsheet();
    }

    // 5. CORE ROUTER SWITCH (All handlers receive targetSpreadsheet, company_id, branch_id)
    var result;
    switch (action) {
      case "initialize_tenant_sheet":
      case "init_tenant_sheet":
      case "setup_tenant_tabs":
        var targetSs = targetSpreadsheet;
        if (explicitSheetId && explicitSheetId !== MASTER_ID && (!targetSs || targetSs.getId() === MASTER_ID)) {
          if (sheetOpenError) {
            return json({
              success: false,
              error: "CANNOT_OPEN_SHEET",
              message: "Cannot open Google Sheet with ID '" + explicitSheetId + "': " + sheetOpenError + ". Please ensure the Google Sheet is shared with the account running the Apps Script (or set to 'Anyone with the link can edit')."
            });
          }
        }
        if (targetSs) {
          result = setupTenantSpreadsheetTabs(
            targetSs,
            company_id,
            (req.data && req.data.company_name) || req.company_name || company_id,
            req.initial_products || (req.data && req.data.initial_products)
          );
        } else {
          result = { success: false, message: "Could not open target spreadsheet" };
        }
        break;

      case "get_inventory":
      case "get_products":
        result = handleGetInventory(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "sync_inventory":
      case "upsert_product":
        result = handleSyncInventory(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "batch_sync_writes":
      case "bulk_sync_writes":
      case "batch_sync":
        result = handleBatchSyncWrites(req, targetSpreadsheet, company_id, branch_id);
        break;
      case "signup":
        result = handleSignup(req.data || req);
        break;

      case "login":
        result = handleLogin(req.data || req);
        break;

      case "login_owner":
      case "owner_login":
        result = handleOwnerLogin(req.data || req);
        break;

      case "login_staff":
      case "staff_login":
      case "verify_staff_pin":
        result = handleStaffLogin(req.data || req);
        break;

      case "confirm_payment":
        result = handleConfirmPayment(req);
        break;

      case "extend_trial":
        result = handleExtendTrial(req);
        break;

      case "create_branch":
      case "upsert_branch":
        result = handleCreateBranch(req);
        break;

      case "upsert_staff":
        result = handleUpsertStaff(req);
        break;

      case "get_tenant_context":
        result = handleGetTenantContext(req);
        break;

      case "get_users_since":
        result = handleGetUsersSince(req);
        break;

      case "get_branches_since":
        result = handleGetBranchesSince(req);
        break;

      case "lookup_company":
        result = handleLookupCompany(req);
        break;

      case "lookup_branch":
        result = handleLookupBranch(req);
        break;

      case "schema_health_check":
        result = handleSchemaHealthCheck(req, targetSpreadsheet);
        break;

      case "merge_duplicate_companies":
        result = handleMergeDuplicateCompanies(req);
        break;

      case "migrate_tenant":
        result = handleMigrateTenant(req);
        break;

      case "add_direct_grv":
        result = handleAddDirectGRV(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "approve_direct_grv":
        result = handleApproveDirectGRV(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "submit_eod":
        result = handleSubmitEOD(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "approve_eod":
        result = handleApproveEOD(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "add_sale":
        result = handleAddSale(req, targetSpreadsheet, company_id, branch_id);
        break;

      // Existing Inventory Stock Actions (scoped to targetSpreadsheet and company_id)
      case "receive_stock":
        result = handleReceiveStock(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "sell_stock":
        result = handleSellStock(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "break_case":
        result = handleBreakCase(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "get_stock":
        result = handleGetStock(req, targetSpreadsheet, company_id, branch_id);
        break;

      // Multi-Tenant Data Query (Company A cannot see Company B data)
      case "get_data":
      case "query":
        result = handleGetData(req, targetSpreadsheet, company_id, branch_id);
        break;

      // Multi-Tenant Data Mutations (Sync Queue CRUD)
      case "insert":
      case "INSERT":
        result = handleGenericInsert(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "update":
      case "UPDATE":
        result = handleGenericUpdate(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "delete":
      case "DELETE":
        result = handleGenericDelete(req, targetSpreadsheet, company_id, branch_id);
        break;

      case "provision_tenant_sheet":
      case "create_tenant_sheet":
        result = handleProvisionTenantSheet(req.data || req);
        break;

      case "setup_sheets":
      case "init_master_sheet":
        result = setupSheets();
        break;

      case "get_companies":
        result = handleGetCompanies(req);
        break;

      case "get_users":
        result = handleGetUsers(req.company_id || (req.data && req.data.company_id));
        break;

      case "sync_company":
      case "register_company":
        result = handleSyncCompany(req.data || req);
        break;

      case "sync_companies_bulk":
      case "bulk_sync_companies":
        result = handleBulkSyncCompanies(req.data || req);
        break;

      default:
        result = { success: false, message: "Unknown action: " + action };
        break;
    }

    // Save write action result for idempotency caching
    if (isWriteAction && clientRequestId && result && result.success) {
      saveRequestResponse(master, clientRequestId, action, result);
    }

    // Invalidate company cache on company state mutations
    if (["signup", "sync_company", "register_company", "confirm_payment", "extend_trial", "provision_tenant_sheet", "create_tenant_sheet"].indexOf(action) !== -1) {
      invalidateCompanyCache(company_id || (result && (result.company_id || result.companyId)));
    }

    return json(result);

  } catch (err) {
    return json({
      success: false,
      error: "SERVER_EXCEPTION",
      message: err.toString(),
      stack: err.stack
    });
  } finally {
    if (hasLock && lock) {
      try {
        lock.releaseLock();
      } catch (unlockErr) {}
    }
  }
}

