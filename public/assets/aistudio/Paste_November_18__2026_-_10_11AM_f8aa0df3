function getDefaultPermissionsList(role) {
  var seed = getSeedPermissions52();
  var filtered = [];
  for (var i = 0; i < seed.length; i++) {
    var r = seed[i];
    if (r[0] === role || r[0] === "ALL" || role === "OWNER" || role === "ADMIN") {
      filtered.push({
        role: r[0],
        module: r[1],
        action: r[2],
        allowed: r[3],
        label: r[4],
        section: r[5],
        restricted: r[6]
      });
    }
  }
  return filtered;
}

