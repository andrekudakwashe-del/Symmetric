/**
 * UPSERT STAFF
 * Deduplicates by user_id OR (company_id + email), inserts or updates, and sets updated_at.
 */
function handleUpsertStaff(req) {
  var data = req.data || req;
  var compId = data.company_id || data.companyId || req.company_id;
  if (!compId) {
    return { success: false, error: "MISSING_COMPANY_ID", message: "company_id is required to upsert staff" };
  }

  var master = getMasterSpreadsheet();
  var sheet = master.getSheetByName(TAB_USERS);
  if (!sheet) {
    sheet = master.insertSheet(TAB_USERS);
    var uHeaders = ["user_id", "company_id", "branch_id", "full_name", "email", "password_hash", "role", "pin", "is_active", "updated_at"];
    sheet.appendRow(uHeaders);
    sheet.getRange(1, 1, 1, uHeaders.length).setBackground("#1E293B").setFontColor("#FFFFFF").setFontWeight("bold");
  }

  var uid = data.user_id || data.id || "";
  var email = data.email ? String(data.email).trim().toLowerCase() : "";
  var fullName = data.full_name || data.name || "Staff Member";
  var branchId = data.branch_id || data.branchId || getTenantPrimaryBranch(compId);
  var role = (data.role || "CASHIER").toUpperCase();
  var pin = data.pin ? String(data.pin).trim() : "1234";
  var rawPass = data.password || data.password_hash || "Pass123";
  var passHash = (rawPass.indexOf("HASH_") === 0 || rawPass.length === 64) ? rawPass : hashPasswordSha256(rawPass);
  var isActive = data.is_active !== undefined ? Boolean(data.is_active) : (data.active !== undefined ? (data.active === "Y" || data.active === true) : true);
  var nowIso = new Date().toISOString();

  var values = sheet.getDataRange().getValues();
  var headers = values[0].map(function(h) { return String(h).trim().toLowerCase(); });
  var idIdx = headers.indexOf("user_id");
  var compIdx = headers.indexOf("company_id");
  var brIdx = headers.indexOf("branch_id");
  var nameIdx = headers.indexOf("full_name");
  var emailIdx = headers.indexOf("email");
  var passIdx = headers.indexOf("password_hash");
  var roleIdx = headers.indexOf("role");
  var pinIdx = headers.indexOf("pin");
  var activeIdx = headers.indexOf("is_active");
  var updatedIdx = headers.indexOf("updated_at");

  if (updatedIdx === -1) {
    sheet.getRange(1, headers.length + 1).setValue("updated_at")
      .setBackground("#1E293B").setFontColor("#FFFFFF").setFontWeight("bold");
    updatedIdx = headers.length;
    headers.push("updated_at");
  }

  var targetRow = -1;
  for (var i = 1; i < values.length; i++) {
    var row = values[i];
    var rUid = idIdx >= 0 ? String(row[idIdx]).trim() : "";
    var rComp = compIdx >= 0 ? String(row[compIdx]).trim() : "";
    var rEmail = emailIdx >= 0 ? String(row[emailIdx]).trim().toLowerCase() : "";

    // Dedup by user_id OR (company_id + email)
    var isUidMatch = uid && rUid && uid === rUid;
    var isEmailCompMatch = email && rEmail && email === rEmail && rComp === String(compId).trim();

    if (isUidMatch || isEmailCompMatch) {
      targetRow = i + 1;
      if (!uid && rUid) uid = rUid;
      break;
    }
  }

  if (targetRow > 0) {
    // Update existing user
    if (brIdx >= 0 && branchId) sheet.getRange(targetRow, brIdx + 1).setValue(branchId);
    if (nameIdx >= 0 && fullName) sheet.getRange(targetRow, nameIdx + 1).setValue(fullName);
    if (emailIdx >= 0 && email) sheet.getRange(targetRow, emailIdx + 1).setValue(email);
    if (roleIdx >= 0 && role) sheet.getRange(targetRow, roleIdx + 1).setValue(role);
    if (pinIdx >= 0 && pin) sheet.getRange(targetRow, pinIdx + 1).setValue(pin);
    if (activeIdx >= 0) sheet.getRange(targetRow, activeIdx + 1).setValue(isActive);
    if (data.password && passIdx >= 0) sheet.getRange(targetRow, passIdx + 1).setValue(passHash);
    sheet.getRange(targetRow, updatedIdx + 1).setValue(nowIso);

    return {
      success: true,
      action: "updated",
      user_id: uid,
      company_id: compId,
      branch_id: branchId,
      full_name: fullName,
      email: email,
      role: role,
      updated_at: nowIso,
      message: "Staff member updated successfully"
    };
  } else {
    // Insert new user
    if (!uid) {
      uid = "USR-" + Date.now().toString(36).toUpperCase();
    }
    var newRow = [uid, compId, branchId, fullName, email, passHash, role, pin, isActive, nowIso];
    sheet.appendRow(newRow);

    return {
      success: true,
      action: "inserted",
      user_id: uid,
      company_id: compId,
      branch_id: branchId,
      full_name: fullName,
      email: email,
      role: role,
      updated_at: nowIso,
      message: "Staff member inserted successfully"
    };
  }
}

