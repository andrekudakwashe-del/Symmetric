/**
 * SIGNUP TENANT:
 * Creates Google Drive Folder, Creates Branch Spreadsheet with Monthly Tabs,
 * and Inserts into `companies`, `branches`, `users`.
 */
function handleSignup(data) {
  var master = getMasterSpreadsheet();
  var compName = data.company_name || data.companyName || "New Enterprise";
  var ownerEmail = data.owner_email || data.email || "";
  var ownerPhone = data.phone || data.ownerPhone || "";

  // WORK STREAM E: Deduplication - Check if company already exists by email, name, or phone
  var lookup = handleLookupCompany({
    owner_email: ownerEmail,
    company_name: compName,
    phone: ownerPhone
  });
  if (lookup && lookup.exists && lookup.company_id) {
    var existingComp = getCompany(lookup.company_id);
    return {
      success: true,
      duplicate: true,
      company_id: lookup.company_id,
      company_name: lookup.company_name || compName,
      branch_id: lookup.branch_id || getTenantPrimaryBranch(lookup.company_id),
      sheet_id: lookup.sheet_id || (existingComp ? existingComp.sheet_id : MASTER_ID),
