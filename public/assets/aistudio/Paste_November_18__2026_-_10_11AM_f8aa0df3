      nowIso
    ]);
  }

  invalidateCompanyCache(compId);
  logAudit(compId, branchId, userId, "TENANT_SIGNUP", "Auth", compId, "Company signed up with 14-day trial until " + nextBilling);

  return {
    success: true,
    company_id: compId,
    branch_id: branchId,
    user_id: userId,
    sheet_id: newSheetId,
    trial_days: 14,
    trial_start_date: trialStart,
