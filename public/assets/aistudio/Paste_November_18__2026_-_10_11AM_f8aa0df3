  var planIdx = headers.indexOf("plan");
  var nextBillingIdx = headers.indexOf("next_billing_date");
  var updatedIdx = headers.indexOf("updated_at");

  var found = false;
  var nextBilling = new Date(Date.now() + (months * 30 * 86400000)).toISOString().split('T')[0];
  var nowIso = new Date().toISOString();

  for (var i = 1; i < data.length; i++) {
    var rowCid = compIdIdx >= 0 ? data[i][compIdIdx] : data[i][0];
    if (rowCid && String(rowCid).trim() === targetCompanyId.toString().trim()) {
      if (statusIdx >= 0) sheet.getRange(i + 1, statusIdx + 1).setValue("ACTIVE");
      if (planIdx >= 0) sheet.getRange(i + 1, planIdx + 1).setValue(plan);
      if (nextBillingIdx >= 0) sheet.getRange(i + 1, nextBillingIdx + 1).setValue(nextBilling);
      if (updatedIdx >= 0) sheet.getRange(i + 1, updatedIdx + 1).setValue(nowIso);
      found = true;
      break;
    }
  }

  if (!found) {
    return { success: false, message: "Company not found: " + targetCompanyId };
