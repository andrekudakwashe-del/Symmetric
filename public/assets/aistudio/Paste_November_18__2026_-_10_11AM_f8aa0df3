  // 3. Insert into users
  var userSheet = master.getSheetByName(TAB_USERS);
  if (userSheet) {
    userSheet.appendRow([
      userId,
      compId,
      branchId,
      data.full_name || "Enterprise Owner",
      ownerEmail,
      data.password || "Pass123",
      "OWNER",
