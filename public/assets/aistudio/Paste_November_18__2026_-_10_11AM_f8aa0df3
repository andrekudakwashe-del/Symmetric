  var compId = "COMP-" + Date.now().toString(36).toUpperCase();
  var branchId = "BR-" + Date.now().toString(36).toUpperCase();
  var userId = "USR-" + Date.now().toString(36).toUpperCase();
  var nowIso = new Date().toISOString();

