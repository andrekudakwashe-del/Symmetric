/**
 * GET TENANT CONTEXT
 * Returns lightweight tenant fields (company_id, company_name, subscription_status,
 * plan, next_billing_date, trial_days_remaining, sheet_id, branch_isolation_mode,
 * schema_version, updated_at). Reads only the target row.
 */
function handleGetTenantContext(req) {
  var compId = req.company_id || (req.data && req.data.company_id) || (req.parameter && req.parameter.company_id);
  if (!compId) {
    return { success: false, error: "MISSING_COMPANY_ID", message: "company_id is required" };
  }

  var master = getMasterSpreadsheet();
  var sheet = master.getSheetByName(TAB_COMPANIES);
  if (!sheet || sheet.getLastRow() <= 1) {
    return { success: false, error: "NOT_FOUND", message: "Company not found: " + compId };
  }

  var data = sheet.getDataRange().getValues();
  var headers = data[0].map(function(h) { return String(h).trim().toLowerCase(); });
  var idIdx = headers.indexOf("company_id");
  var nameIdx = headers.indexOf("company_name");
  var statusIdx = headers.indexOf("subscription_status");
  var planIdx = headers.indexOf("plan");
  var nextBillingIdx = headers.indexOf("next_billing_date");
  var trialStartIdx = headers.indexOf("trial_start_date");
  var sheetIdIdx = headers.indexOf("sheet_id");
  var modeIdx = headers.indexOf("branch_isolation_mode");
  var schemaIdx = headers.indexOf("schema_version");
  var updatedIdx = headers.indexOf("updated_at");
  var createdIdx = headers.indexOf("created_at");

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (String(row[idIdx]).trim() === String(compId).trim()) {
      var nextBilling = nextBillingIdx >= 0 && row[nextBillingIdx] ? String(row[nextBillingIdx]) : "";
      var trialStart = trialStartIdx >= 0 && row[trialStartIdx] ? String(row[trialStartIdx]) : "";
      var daysRemaining = 14;
      if (nextBilling) {
        var diffMs = new Date(nextBilling).getTime() - new Date().getTime();
        daysRemaining = Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
      } else if (trialStart) {
        daysRemaining = Math.max(0, 14 - daysSince(trialStart));
      }

      var tenantObj = {
        company_id: String(row[idIdx]).trim(),
        company_name: nameIdx >= 0 && row[nameIdx] ? String(row[nameIdx]) : compId,
        subscription_status: statusIdx >= 0 && row[statusIdx] ? String(row[statusIdx]).toUpperCase() : "TRIAL",
        plan: planIdx >= 0 && row[planIdx] ? String(row[planIdx]).toUpperCase() : "PROFESSIONAL",
        next_billing_date: nextBilling,
        trial_days_remaining: daysRemaining,
        sheet_id: sheetIdIdx >= 0 && row[sheetIdIdx] ? String(row[sheetIdIdx]) : MASTER_ID,
        branch_isolation_mode: modeIdx >= 0 && row[modeIdx] ? String(row[modeIdx]) : "ROW_LEVEL",
        schema_version: schemaIdx >= 0 && row[schemaIdx] ? Number(row[schemaIdx]) : CURRENT_SCHEMA_VERSION,
        updated_at: updatedIdx >= 0 && row[updatedIdx] ? String(row[updatedIdx]) : ((createdIdx >= 0 && row[createdIdx]) ? String(row[createdIdx]) : new Date().toISOString())
      };

      return {
        success: true,
        tenant: tenantObj,
        company_id: tenantObj.company_id,
        company_name: tenantObj.company_name,
        subscription_status: tenantObj.subscription_status,
        plan: tenantObj.plan,
        next_billing_date: tenantObj.next_billing_date,
        trial_days_remaining: tenantObj.trial_days_remaining,
        sheet_id: tenantObj.sheet_id,
        branch_isolation_mode: tenantObj.branch_isolation_mode,
        schema_version: tenantObj.schema_version,
