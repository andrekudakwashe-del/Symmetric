/**
 * Cache invalidation on company updates
 */
function invalidateCompanyCache(company_id) {
  if (!company_id) return;
  try {
    CACHE.remove("comp_" + company_id);
    CACHE.remove("companies_list");
    CACHE.remove("primary_br_" + company_id);
    CACHE.remove("sheet_" + company_id + "_default");
    CACHE.remove("sheet_" + company_id + "_BR-MAIN");
  } catch (e) {
    Logger.log("Error invalidating cache for " + company_id + ": " + e.toString());
  }
}

/**
 * Looks up the primary branch from the branches tab for a tenant.
 * Replaces hardcoded "BR-MAIN" fallbacks. Logs when fallback is used.
 */
function getTenantPrimaryBranch(company_id) {
  if (!company_id) return "BR-MAIN";
  var cacheKey = "primary_br_" + company_id;
  var cached = CACHE.get(cacheKey);
  if (cached) return cached;

  try {
    var master = getMasterSpreadsheet();
    var branchSheet = master.getSheetByName(TAB_BRANCHES);
    if (branchSheet && branchSheet.getLastRow() > 1) {
      var data = branchSheet.getDataRange().getValues();
      var headers = data[0].map(function(h) { return String(h).trim().toLowerCase(); });
      var cIdx = headers.indexOf("company_id");
      var bIdx = headers.indexOf("branch_id");
      var aIdx = headers.indexOf("is_active");

      if (cIdx >= 0 && bIdx >= 0) {
        for (var i = 1; i < data.length; i++) {
          var row = data[i];
          if (String(row[cIdx]).trim() === String(company_id).trim()) {
            var isActive = aIdx >= 0 ? (row[aIdx] === true || String(row[aIdx]).toLowerCase() === "true" || String(row[aIdx]).toUpperCase() === "Y") : true;
            if (isActive) {
              var foundBr = String(row[bIdx]).trim();
              if (foundBr) {
                CACHE.put(cacheKey, foundBr, CACHE_TTL);
                return foundBr;
              }
            }
          }
        }
      }
    }
  } catch (err) {
    Logger.log("Error finding primary branch for " + company_id + ": " + err.toString());
  }

  Logger.log("[FALLBACK_BRANCH_USED] No primary branch found in branches tab for company: " + company_id + ", falling back to BR-MAIN");
  return "BR-MAIN";
}

/**
 * Performance: Replaces per-request ensureAllMasterTabsExist with daily check flag
 */
function checkDailyMasterTabs(master) {
  try {
    var props = PropertiesService.getScriptProperties();
    var lastCheck = props.getProperty("LAST_MASTER_TABS_CHECK");
    var today = new Date().toISOString().split("T")[0];
    if (lastCheck !== today) {
      ensureAllMasterTabsExist(master);
      props.setProperty("LAST_MASTER_TABS_CHECK", today);
    }
  } catch (e) {
    Logger.log("checkDailyMasterTabs fallback: " + e.toString());
  }
}

/**
 * Performance: Batches row appends into a single setValues() call
 */
function batchAppendRows(sheet, rows) {
  if (!sheet || !rows || rows.length === 0) return;
  var startRow = sheet.getLastRow() + 1;
  var numCols = rows[0].length;
  sheet.getRange(startRow, 1, rows.length, numCols).setValues(rows);
}

/**
 * Idempotency: Checks cache and request_log sheet for previously processed request
 */
function findCachedResponse(master, clientRequestId) {
  if (!clientRequestId) return null;
  var cacheKey = "req_" + clientRequestId;
  var cached = CACHE.get(cacheKey);
  if (cached) {
    try {
      var cachedObj = JSON.parse(cached);
      cachedObj._cached = true;
      return cachedObj;
    } catch (e) {}
  }
  try {
    var sheet = master.getSheetByName(TAB_REQUEST_LOG);
    if (!sheet || sheet.getLastRow() <= 1) return null;
    var data = sheet.getDataRange().getValues();
    var idCol = 0;
    var jsonCol = 4;
    for (var i = data.length - 1; i >= 1; i--) {
      if (String(data[i][idCol]).trim() === String(clientRequestId).trim()) {
        var respStr = data[i][jsonCol];
        if (respStr) {
          var parsed = JSON.parse(respStr);
          CACHE.put(cacheKey, respStr, CACHE_TTL);
          parsed._cached = true;
          return parsed;
        }
      }
    }
  } catch (err) {
    Logger.log("findCachedResponse error: " + err.toString());
  }
  return null;
}

/**
 * Idempotency: Saves write response to cache and request_log tab
 */
function saveRequestResponse(master, clientRequestId, action, result) {
  if (!clientRequestId || !result) return;
  var cacheKey = "req_" + clientRequestId;
  var jsonStr = JSON.stringify(result);
  try {
    CACHE.put(cacheKey, jsonStr, CACHE_TTL);
    var sheet = master.getSheetByName(TAB_REQUEST_LOG);
    if (!sheet) {
      sheet = master.insertSheet(TAB_REQUEST_LOG);
      sheet.appendRow(["request_id", "action", "received_at", "response_hash", "response_json"]);
      sheet.getRange(1, 1, 1, 5).setBackground("#1E293B").setFontColor("#FFFFFF").setFontWeight("bold");
    }
    var hash = "";
    try {
      if (typeof Utilities !== "undefined" && Utilities.computeDigest) {
        hash = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, jsonStr));
      } else {
        hash = "H_" + Math.abs(jsonStr.split("").reduce(function(a, b) { a = ((a << 5) - a) + b.charCodeAt(0); return a & a; }, 0)).toString(16);
      }
    } catch (hErr) {
      hash = "H_" + Date.now();
    }
    sheet.appendRow([clientRequestId, action, new Date().toISOString(), hash, jsonStr]);
  } catch (err) {
    Logger.log("saveRequestResponse error: " + err.toString());
  }
}

/**
 * Backfills updated_at and schema_version columns on existing master sheet tabs
 */
function backfillSchemaColumns(master) {
  if (!master) master = getMasterSpreadsheet();
  var stats = {
    updated_at_backfilled: 0,
    schema_version_backfilled: 0
  };
  var nowIso = new Date().toISOString();

  // 1. companies: updated_at, schema_version
  var compSheet = master.getSheetByName(TAB_COMPANIES);
  if (compSheet && compSheet.getLastRow() >= 1) {
    var cVals = compSheet.getDataRange().getValues();
    var cHeaders = cVals[0].map(function(h) { return String(h).trim().toLowerCase(); });
    var updatedIdx = cHeaders.indexOf("updated_at");
    var schemaIdx = cHeaders.indexOf("schema_version");

    if (updatedIdx === -1) {
      compSheet.getRange(1, cHeaders.length + 1).setValue("updated_at")
        .setBackground("#1E293B").setFontColor("#FFFFFF").setFontWeight("bold");
      updatedIdx = cHeaders.length;
      cHeaders.push("updated_at");
    }

    if (schemaIdx === -1) {
      compSheet.getRange(1, cHeaders.length + 1).setValue("schema_version")
        .setBackground("#1E293B").setFontColor("#FFFFFF").setFontWeight("bold");
      schemaIdx = cHeaders.length;
      cHeaders.push("schema_version");
    }

    var createdIdx = cHeaders.indexOf("created_at");
    for (var r = 1; r < cVals.length; r++) {
      var row = cVals[r];
      if (!row[updatedIdx]) {
        var fallbackDate = (createdIdx >= 0 && row[createdIdx]) ? String(row[createdIdx]) : nowIso;
        compSheet.getRange(r + 1, updatedIdx + 1).setValue(fallbackDate);
        stats.updated_at_backfilled++;
      }
      if (!row[schemaIdx]) {
        compSheet.getRange(r + 1, schemaIdx + 1).setValue(CURRENT_SCHEMA_VERSION);
