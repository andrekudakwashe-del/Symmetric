/**
 * SCHEMA HEALTH CHECK
 * Inspects all TAB_TEMPLATES on the target spreadsheet (or master) and checks
 * expected_version, stored_version, missing_tabs, missing_columns, strategy, and recommended_action.
 */
function handleSchemaHealthCheck(req, targetSpreadsheet) {
  var data = req.data || req || {};
  var compId = data.company_id || req.company_id || "";
  var ss = targetSpreadsheet || getMasterSpreadsheet();

  var storedVersion = CURRENT_SCHEMA_VERSION;
  var strategy = "ROW_LEVEL";

  if (compId) {
    var comp = getCompany(compId);
    if (comp) {
      if (comp.schema_version) storedVersion = Number(comp.schema_version);
      if (comp.branch_isolation_mode) strategy = comp.branch_isolation_mode;
    }
  }

  var missingTabs = [];
  var missingColumns = {};

  var templateKeys = Object.keys(TAB_TEMPLATES);
  for (var k = 0; k < templateKeys.length; k++) {
    var tabKey = templateKeys[k];
    var tabCfg = TAB_TEMPLATES[tabKey];

    // For monthly sharded tabs, check if either the base tab or the current month tab exists
    var tabSheet = ss.getSheetByName(tabKey);
    if (!tabSheet && tabCfg.shardedMonthly) {
      tabSheet = ss.getSheetByName(getMonthlyTabName(tabKey));
    }

    if (!tabSheet) {
      missingTabs.push(tabKey);
    } else {
      var dataVals = tabSheet.getDataRange().getValues();
      var headerRow = dataVals.length > 0 ? dataVals[0] : [];
      if (!headerRow || headerRow.length === 0) {
        missingColumns[tabKey] = tabCfg.headers.slice();
      } else {
        var existingHeaders = headerRow.map(function(h) { return String(h).trim().toLowerCase(); });
        var missingHeadersInTab = [];
        for (var h = 0; h < tabCfg.headers.length; h++) {
          var expectedHeader = tabCfg.headers[h];
          if (existingHeaders.indexOf(expectedHeader.toLowerCase()) === -1) {
            missingHeadersInTab.push(expectedHeader);
          }
        }
        if (missingHeadersInTab.length > 0) {
          missingColumns[tabKey] = missingHeadersInTab;
        }
      }
    }
  }

  var needsMigration = missingTabs.length > 0 || Object.keys(missingColumns).length > 0 || storedVersion < CURRENT_SCHEMA_VERSION;

  return {
    success: true,
    expected_version: CURRENT_SCHEMA_VERSION,
    stored_version: storedVersion,
    missing_tabs: missingTabs,
    missing_columns: missingColumns,
    strategy: strategy,
    recommended_action: needsMigration ? "RUN_MIGRATION" : "NONE"
  };
}

/**
 * ROUTE TARGET SHEETS PER TENANT ISOLATION STRATEGY
 * Supports ROW_LEVEL, BRANCH_SPECIFIC, and HYBRID
 */
function getTenantTargetSheets(spreadsheet, baseTab, companyId, branchId, defaultHeaders, isMonthly) {
  if (!spreadsheet) spreadsheet = getMasterSpreadsheet();
  var comp = companyId ? getCompany(companyId) : null;
  var strategy = (comp && comp.branch_isolation_mode) ? comp.branch_isolation_mode : "ROW_LEVEL";
  var results = [];

  if (strategy === "BRANCH_SPECIFIC") {
    var bTabName = baseTab + (branchId ? "_" + branchId : "");
    var bSheet = spreadsheet.getSheetByName(bTabName);
    if (!bSheet) {
      bSheet = spreadsheet.insertSheet(bTabName);
      if (defaultHeaders && defaultHeaders.length > 0) {
        bSheet.appendRow(defaultHeaders);
        try {
          bSheet.getRange(1, 1, 1, defaultHeaders.length)
            .setBackground("#4F46E5")
            .setFontColor("#FFFFFF")
            .setFontWeight("bold");
        } catch (e) {}
      }
    }
    results.push(bSheet);
    return results;
  }

  if (strategy === "HYBRID") {
    var bTabName = baseTab + (branchId ? "_" + branchId : "");
    var bSheet = spreadsheet.getSheetByName(bTabName);
    if (!bSheet) {
      bSheet = spreadsheet.insertSheet(bTabName);
      if (defaultHeaders && defaultHeaders.length > 0) {
        bSheet.appendRow(defaultHeaders);
      }
    }
    results.push(bSheet);
  }

  // ROW_LEVEL (or master partition for HYBRID)
  var tabSheet = isMonthly
    ? getOrCreateMonthlySheet(spreadsheet, baseTab, defaultHeaders)
    : (spreadsheet.getSheetByName(baseTab) || spreadsheet.insertSheet(baseTab));

  if (!isMonthly && tabSheet.getLastRow() === 0 && defaultHeaders && defaultHeaders.length > 0) {
    tabSheet.appendRow(defaultHeaders);
  }

  var alreadyIn = false;
  for (var j = 0; j < results.length; j++) {
    if (results[j].getName() === tabSheet.getName()) {
      alreadyIn = true;
      break;
    }
  }
  if (!alreadyIn) {
    results.push(tabSheet);
  }

  return results;
}

/**
 * MERGE DUPLICATE COMPANIES
 * Safely moves all branches, users, and transactions from source to target company,
 * deduplicates entities, and archives the source company with MERGED status.
 */
function handleMergeDuplicateCompanies(req, spreadsheet) {
  var ss = spreadsheet || getMasterSpreadsheet();
  var srcId = req.source_company_id || (req.data && req.data.source_company_id);
  var tgtId = req.target_company_id || (req.data && req.data.target_company_id);
  var confirmed = req.confirmed === true || (req.data && req.data.confirmed === true);

  if (!confirmed) {
    return {
      success: false,
      requiresConfirmation: true,
      message: "Requires manual confirmation"
    };
  }

  if (!srcId || !tgtId) {
    return { success: false, message: "Both source_company_id and target_company_id are required" };
  }

  if (srcId === tgtId) {
    return { success: false, message: "Source and target company cannot be identical" };
  }

  var srcComp = getCompany(srcId);
  var tgtComp = getCompany(tgtId);
  if (!srcComp) return { success: false, message: "Source company not found: " + srcId };
  if (!tgtComp) return { success: false, message: "Target company not found: " + tgtId };

  var rowsMoved = {
    branches: 0,
    users: 0,
    sales: 0,
    inventory: 0,
    other: 0
  };

  // 1. Move Branches (deduplicate by name)
  var branchesSheet = ss.getSheetByName(TAB_BRANCHES);
  if (branchesSheet && branchesSheet.getLastRow() > 1) {
    var bData = branchesSheet.getDataRange().getValues();
    var bHeaders = bData[0];
    var compCol = bHeaders.indexOf("company_id");
    var nameCol = bHeaders.indexOf("name");
    var activeCol = bHeaders.indexOf("is_active");

    var tgtBranchNames = {};
    for (var r = 1; r < bData.length; r++) {
      if (bData[r][compCol] === tgtId) {
        tgtBranchNames[String(bData[r][nameCol]).toLowerCase().trim()] = true;
      }
    }

    for (var r = 1; r < bData.length; r++) {
      if (bData[r][compCol] === srcId) {
        var srcBName = String(bData[r][nameCol]).toLowerCase().trim();
        if (tgtBranchNames[srcBName]) {
          if (activeCol !== -1) branchesSheet.getRange(r + 1, activeCol + 1).setValue("false");
        } else {
          branchesSheet.getRange(r + 1, compCol + 1).setValue(tgtId);
          rowsMoved.branches++;
        }
      }
    }
  }

  // 2. Move Users (deduplicate by email)
  var usersSheet = ss.getSheetByName(TAB_USERS);
  if (usersSheet && usersSheet.getLastRow() > 1) {
    var uData = usersSheet.getDataRange().getValues();
    var uHeaders = uData[0];
    var compCol = uHeaders.indexOf("company_id");
    var emailCol = uHeaders.indexOf("email");
    var activeCol = uHeaders.indexOf("active");

    var tgtEmails = {};
    for (var r = 1; r < uData.length; r++) {
      if (uData[r][compCol] === tgtId) {
        tgtEmails[String(uData[r][emailCol]).toLowerCase().trim()] = true;
      }
    }

    for (var r = 1; r < uData.length; r++) {
      if (uData[r][compCol] === srcId) {
        var srcEm = String(uData[r][emailCol]).toLowerCase().trim();
        if (tgtEmails[srcEm]) {
          if (activeCol !== -1) usersSheet.getRange(r + 1, activeCol + 1).setValue("N");
        } else {
          usersSheet.getRange(r + 1, compCol + 1).setValue(tgtId);
          rowsMoved.users++;
        }
      }
    }
  }

  // 3. Move Sales across Sales tabs
  var allSheets = ss.getSheets();
  for (var si = 0; si < allSheets.length; si++) {
    var curSheet = allSheets[si];
    var sName = curSheet.getName();
    if (sName.indexOf("Sales") === 0 && curSheet.getLastRow() > 1) {
      var sData = curSheet.getDataRange().getValues();
      var sHeaders = sData[0];
      var sCompCol = sHeaders.indexOf("company_id");
      if (sCompCol !== -1) {
        for (var r = 1; r < sData.length; r++) {
          if (sData[r][sCompCol] === srcId) {
            curSheet.getRange(r + 1, sCompCol + 1).setValue(tgtId);
            rowsMoved.sales++;
          }
        }
      }
    }
  }

  // 4. Archive source company
  var compSheet = ss.getSheetByName(TAB_COMPANIES);
  if (compSheet && compSheet.getLastRow() > 1) {
    var cData = compSheet.getDataRange().getValues();
    var cHeaders = cData[0];
    var idCol = cHeaders.indexOf("company_id");
    var statusCol = cHeaders.indexOf("subscription_status");
    var mergedCol = cHeaders.indexOf("merged_into");
    var updCol = cHeaders.indexOf("updated_at");

    for (var cr = 1; cr < cData.length; cr++) {
      if (cData[cr][idCol] === srcId) {
        if (statusCol !== -1) compSheet.getRange(cr + 1, statusCol + 1).setValue("MERGED");
        if (mergedCol !== -1) {
          compSheet.getRange(cr + 1, mergedCol + 1).setValue(tgtId);
        } else {
          var nextCol = compSheet.getLastColumn() + 1;
          compSheet.getRange(1, nextCol).setValue("merged_into");
          compSheet.getRange(cr + 1, nextCol).setValue(tgtId);
        }
        if (updCol !== -1) compSheet.getRange(cr + 1, updCol + 1).setValue(new Date().toISOString());
        break;
      }
    }
  }

  invalidateCompanyCache(srcId);
  invalidateCompanyCache(tgtId);
  logAudit(tgtId, "SYSTEM", req.user_id || "SYSTEM", "MERGE_COMPANIES", "Company", srcId, "Merged into " + tgtId);

  return {
    success: true,
    source_company_id: srcId,
    target_company_id: tgtId,
    rows_moved: rowsMoved,
    message: "Source company " + srcId + " successfully merged into " + tgtId
  };
}

/**
 * MIGRATE TENANT
 * Provisions missing tabs and columns based on tenant isolation strategy,
 * updates companies.schema_version, and logs audit trail.
 */
function handleMigrateTenant(req, spreadsheet) {
  var ss = spreadsheet || getMasterSpreadsheet();
  var compId = req.company_id || (req.data && req.data.company_id);
  if (!compId) {
    return { success: false, message: "Missing company_id for migration" };
  }

  var comp = getCompany(compId);
  if (!comp) {
    return { success: false, message: "Company " + compId + " not found" };
  }

  var targetVer = parseInt(req.to_version || req.target_version || CURRENT_SCHEMA_VERSION, 10);
  var currentVer = parseInt(comp.schema_version || 0, 10);
  var strategy = comp.branch_isolation_mode || "ROW_LEVEL";

  var tabsCreated = [];
  var columnsAdded = {};

  // Fetch branches for this tenant
  var tenantBranches = [];
  var branchesSheet = ss.getSheetByName(TAB_BRANCHES);
  if (branchesSheet && branchesSheet.getLastRow() > 1) {
    var bData = branchesSheet.getDataRange().getValues();
    var bHeaders = bData[0];
    var compCol = bHeaders.indexOf("company_id");
    var idCol = bHeaders.indexOf("branch_id");
    for (var r = 1; r < bData.length; r++) {
      if (bData[r][compCol] === compId) {
        tenantBranches.push(bData[r][idCol]);
      }
    }
  }
  if (tenantBranches.length === 0) {
    tenantBranches.push("BR-MAIN");
  }

  // Loop through TAB_TEMPLATES
  var tabKeys = Object.keys(TAB_TEMPLATES);
  for (var k = 0; k < tabKeys.length; k++) {
    var baseName = tabKeys[k];
    var tmpl = TAB_TEMPLATES[baseName];
    var headers = tmpl.headers;

    var tabsToEnsure = [];
    if (strategy === "ROW_LEVEL") {
      tabsToEnsure.push(tmpl.shardedMonthly ? getMonthlyTabName(baseName) : baseName);
    } else if (strategy === "BRANCH_SPECIFIC") {
      for (var bi = 0; bi < tenantBranches.length; bi++) {
        tabsToEnsure.push(baseName + "_" + tenantBranches[bi]);
      }
    } else if (strategy === "HYBRID") {
      tabsToEnsure.push(tmpl.shardedMonthly ? getMonthlyTabName(baseName) : baseName);
      for (var bi = 0; bi < tenantBranches.length; bi++) {
        tabsToEnsure.push(baseName + "_" + tenantBranches[bi]);
      }
    }

    for (var ti = 0; ti < tabsToEnsure.length; ti++) {
      var tName = tabsToEnsure[ti];
      var s = ss.getSheetByName(tName);
      if (!s) {
        s = ss.insertSheet(tName);
        s.appendRow(headers);
        try {
          s.getRange(1, 1, 1, headers.length)
            .setBackground("#4F46E5")
            .setFontColor("#FFFFFF")
            .setFontWeight("bold");
        } catch (e) {}
        tabsCreated.push(tName);
      } else {
        var existingHeaders = s.getLastRow() > 0 ? s.getRange(1, 1, 1, Math.max(1, s.getLastColumn())).getValues()[0] : [];
        var missingInThis = [];
        for (var hi = 0; hi < headers.length; hi++) {
          if (existingHeaders.indexOf(headers[hi]) === -1) {
            missingInThis.push(headers[hi]);
          }
        }
        if (missingInThis.length > 0) {
          var startCol = s.getLastColumn() + 1;
          for (var mi = 0; mi < missingInThis.length; mi++) {
            s.getRange(1, startCol + mi).setValue(missingInThis[mi]);
          }
          columnsAdded[tName] = missingInThis;
        }
      }
    }
  }

  // Update companies sheet schema_version
  var compSheet = ss.getSheetByName(TAB_COMPANIES);
  if (compSheet && compSheet.getLastRow() > 1) {
    var cData = compSheet.getDataRange().getValues();
    var cHeaders = cData[0];
    var idCol = cHeaders.indexOf("company_id");
    var verCol = cHeaders.indexOf("schema_version");
    var updCol = cHeaders.indexOf("updated_at");

    for (var cr = 1; cr < cData.length; cr++) {
      if (cData[cr][idCol] === compId) {
        if (verCol !== -1) compSheet.getRange(cr + 1, verCol + 1).setValue(targetVer);
        if (updCol !== -1) compSheet.getRange(cr + 1, updCol + 1).setValue(new Date().toISOString());
        break;
      }
    }
  }

  invalidateCompanyCache(compId);
  logAudit(compId, "SYSTEM", req.user_id || "SYSTEM", "MIGRATE_TENANT", "Schema", compId, "From v" + currentVer + " to v" + targetVer);

  return {
    success: true,
    company_id: compId,
    from_version: currentVer,
    to_version: targetVer,
    tabs_created: tabsCreated,
    columns_added: columnsAdded,
    message: "Tenant schema successfully migrated to version " + targetVer
  };
}

